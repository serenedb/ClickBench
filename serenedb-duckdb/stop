#!/bin/bash

if [ -f server.pid ]; then
    pid=$(cat server.pid)
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 300); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
    done
    rm -f server.pid
    exit 0
fi
sudo docker stop serenedb >/dev/null 2>&1 || true
sudo docker rm serenedb >/dev/null 2>&1 || true
