#!/bin/bash
set -eu

mkdir -p data
mv hits_*.parquet data/
chmod -R 777 data

# The docker image sees ./data as /data.
if [ -n "${SERENED_BIN:-}" ]; then
    pq="$PWD/data/hits_*.parquet"
else
    pq=/data/hits_*.parquet
fi

psql -h 127.0.0.1 -p 7890 -U postgres -v ON_ERROR_STOP=1 -v pq="$pq" -f create.sql
sync
